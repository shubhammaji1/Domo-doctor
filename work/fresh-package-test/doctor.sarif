{
  "version": "2.1.0",
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "domo-doctor",
          "version": "0.1.0",
          "informationUri": "https://developer.domo.com/",
          "rules": [
            {
              "id": "DD-APPDB-001",
              "shortDescription": {
                "text": "No recognizable AppDB or @domoinc/toolkit usage was found."
              },
              "fullDescription": {
                "text": "No recognizable AppDB or @domoinc/toolkit usage was found."
              }
            },
            {
              "id": "DD-MAN-001",
              "shortDescription": {
                "text": "Manifest file exists."
              },
              "fullDescription": {
                "text": "No problems were detected by this check."
              },
              "helpUri": "https://developer.domo.com/docs/tools/manifest"
            },
            {
              "id": "DD-MAN-002",
              "shortDescription": {
                "text": "Manifest is valid JSON."
              },
              "fullDescription": {
                "text": "No problems were detected by this check."
              },
              "helpUri": "https://developer.domo.com/docs/tools/manifest"
            },
            {
              "id": "DD-MAN-003",
              "shortDescription": {
                "text": "Documented manifest properties have valid shapes."
              },
              "fullDescription": {
                "text": "No problems were detected by this check."
              },
              "helpUri": "https://developer.domo.com/docs/tools/manifest"
            },
            {
              "id": "DD-MAN-004",
              "shortDescription": {
                "text": "Dataset aliases are unique."
              },
              "fullDescription": {
                "text": "No problems were detected by this check."
              },
              "helpUri": "https://developer.domo.com/docs/tools/manifest"
            },
            {
              "id": "DD-MAN-005",
              "shortDescription": {
                "text": "Field aliases are unique within each dataset mapping."
              },
              "fullDescription": {
                "text": "No problems were detected by this check."
              },
              "helpUri": "https://developer.domo.com/docs/tools/manifest"
            },
            {
              "id": "DD-MAN-006",
              "shortDescription": {
                "text": "Dataset and field mapping definitions are well formed."
              },
              "fullDescription": {
                "text": "No problems were detected by this check."
              },
              "helpUri": "https://developer.domo.com/docs/tools/manifest"
            },
            {
              "id": "DD-MAN-007",
              "shortDescription": {
                "text": "No static advanced-proxy requirement was detected."
              },
              "fullDescription": {
                "text": "No DQL, writeback, OAuth, or AppDB request markers were found. Publication readiness and proxy authentication were not verified."
              },
              "helpUri": "https://developer.domo.com/docs/tools/dev-studio-cli"
            },
            {
              "id": "DD-MAP-001",
              "shortDescription": {
                "text": "No unresolved literal dataset aliases were found in recognized Domo data requests."
              },
              "fullDescription": {
                "text": "No unresolved literal dataset aliases were found in recognized Domo data requests."
              }
            },
            {
              "id": "DD-MAP-002",
              "shortDescription": {
                "text": "No dynamic domo.get paths were found."
              },
              "fullDescription": {
                "text": "No dynamic domo.get paths were found."
              }
            },
            {
              "id": "DD-PROXY-001",
              "shortDescription": {
                "text": "Domo CLI executable was found on PATH."
              },
              "fullDescription": {
                "text": "Executable availability was checked from PATH only. Authentication, credentials, network access, and proxy behavior were not checked."
              }
            }
          ]
        }
      },
      "results": [],
      "properties": {
        "scanStatus": "completed",
        "durationMs": 34,
        "summary": {
          "errors": 0,
