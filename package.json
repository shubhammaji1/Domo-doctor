{
  "name": "domo-doctor",
  "version": "0.1.0",
  "description": "Offline-first diagnostics for Domo custom app projects",
  "keywords": [
    "domo",
    "domo-custom-app",
    "diagnostics",
    "static-analysis",
    "cli",
    "developer-tools"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "domo-doctor": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/add-shebang.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "npm run build && node scripts/self-test.mjs",
    "test:vitest": "npm run build && vitest run",
    "test:coverage": "npm run build && vitest run --coverage",
    "format": "prettier --write .",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "fast-glob": "^3.3.3",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1",
    "typescript": "^5.9.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "@types/sarif": "^2.1.7",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.1.11"
  }
}
